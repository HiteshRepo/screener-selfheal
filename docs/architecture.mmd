flowchart TD
    S1["① Trigger collector run"]
    S2["② Poll until dataset ready"]
    S3["③ Download results\nwrite latest.json + previous.json"]
    S4{Health check\nrecord_count?}

    S5["④ Diff snapshots\nlatest vs previous"]
    S6["⑤ Write changes report"]
    S7["⑥ GitHub Actions auto-commit\naudit log in git history"]

    S8["④ Fetch live page HTML"]
    S9["⑤ Parse HTML → build fix prompt\nno hardcoded selectors"]
    S10["⑥ AI rewrites parser\nvalidates via preview"]
    S11{"⑦ Preview returns\nrecords?"}
    S12["⑧ Approve + save\nnew parser version"]
    FAIL["⑧ Abort — broken\nparser not saved"]

    S1 -->|"POST /dca/trigger"| S2
    S2 -->|"GET /dca/dataset"| S3
    S3 --> S4

    S4 -->|"&gt; 0 — healthy"| S5
    S5 --> S6
    S6 --> S7

    S4 -->|"= 0 — broken"| S8
    S8 -->|"POST /datasets/v3/scrape\nBright Data Crawl API"| S9
    S9 -->|"POST /dca/collectors/:id/refactor_template"| S10
    S10 -->|"GET /dca/collectors/:id/refactor_template/progress"| S11
    S11 -->|"yes"| S12
    S12 -->|"POST /dca/collectors/:id/resume_automation_job"| S1
    S11 -->|"no"| FAIL
